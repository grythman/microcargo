# Server port
PORT=3000

# Secret key used to sign login tokens (CHANGE THIS)
JWT_SECRET=change-this-to-a-long-random-secret

# Admin login credentials (cargo operator)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Supabase project URL and public anon key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Postgres Session Pooler URL (recommended for Render)
# Format example:
# postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR_DB_PASSWORD]@<region>.pooler.supabase.com:6543/postgres

# Optional: uploaded avatar storage path on local disk
# UPLOAD_DIR=./data/uploads
